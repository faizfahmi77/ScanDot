<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <application android:allowBackup="false" android:label="ScanDot" android:icon="@drawable/ic_roomscan" android:theme="@style/Theme.RoomScan" android:supportsRtl="true">
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <activity android:name=".OnDeviceCaptureActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
